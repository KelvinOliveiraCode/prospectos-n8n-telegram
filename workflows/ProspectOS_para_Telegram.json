{
  "name": "ProspectOS + Telegram CSV - multi queries",
  "nodes": [
    {
      "parameters": {
        "formFields": {
          "values": [
            { "fieldLabel": "Buscas (1 por linha)", "fieldType": "textarea", "fieldName": "queries", "placeholder": "dentista em Belem\nclinica de estetica em Belem\nacademia em Ananindeua" }
          ]
        }
      },
      "id": "trigger-form",
      "name": "Form Trigger (Localidades + Nichos)",
      "type": "n8n-nodes-base.FormTrigger",
      "position": [0, 0],
      "typeVersion": 1.1
    },
    {
      "parameters": {
        "assignments": { "assignments": [{ "id": "1", "name": "queries", "value": "={{ $json.queries }}", "type": "string" }] }
      },
      "id": "set-query",
      "name": "Montar Queries Multi-Linha",
      "type": "n8n-nodes-base.Set",
      "position": [200, 0],
      "typeVersion": 3
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:5000/api/buscar",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"queries\": {{ JSON.stringify($json.queries) }}\n}"
      },
      "id": "post-buscar",
      "name": "ProspectOS Disparar Busca Ampla",
      "type": "n8n-nodes-base.HttpRequest",
      "position": [400, 0],
      "typeVersion": 4.2
    },
    {
      "parameters": { "amount": 20 },
      "id": "wait",
      "name": "Aguardar 20s",
      "type": "n8n-nodes-base.Wait",
      "position": [600, 0],
      "typeVersion": 1.1
    },
    {
      "parameters": { "method": "GET", "url": "http://localhost:5000/api/buscar/status" },
      "id": "get-status",
      "name": "Consultar Status",
      "type": "n8n-nodes-base.HttpRequest",
      "position": [800, 0],
      "typeVersion": 4.2
    },
    {
      "parameters": { "conditions": { "string": [{ "value1": "{{ $json.status }}", "operator": "equals", "value2": "finalizada" }] } },
      "id": "if-done",
      "name": "Terminou?",
      "type": "n8n-nodes-base.If",
      "position": [1000, 0],
      "typeVersion": 1
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://localhost:5000/api/exportar",
        "options": { "response": { "response": { "responseFormat": "file" } } }
      },
      "id": "get-csv",
      "name": "Baixar CSV Completo",
      "type": "n8n-nodes-base.HttpRequest",
      "position": [1200, 0],
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "channel": "document",
        "text": "ProspectOS finalizado - busca ampla multi-linhas\n\nQueries:\n{{ $('Montar Queries Multi-Linha').first().json.queries }}\n\nCSV completo com nome, telefone, whatsapp_link, endereco, cidade, nicho, site_status - pronto para contato direto por area.",
        "options": {}
      },
      "id": "telegram",
      "name": "Enviar CSV p/ Telegram",
      "type": "n8n-nodes-base.Telegram",
      "position": [1400, 0],
      "typeVersion": 1.2
    }
  ],
  "connections": {
    "Form Trigger (Localidades + Nichos)": { "main": [[{ "node": "Montar Queries Multi-Linha", "type": "main", "index": 0 }]] },
    "Montar Queries Multi-Linha": { "main": [[{ "node": "ProspectOS Disparar Busca Ampla", "type": "main", "index": 0 }]] },
    "ProspectOS Disparar Busca Ampla": { "main": [[{ "node": "Aguardar 20s", "type": "main", "index": 0 }]] },
    "Aguardar 20s": { "main": [[{ "node": "Consultar Status", "type": "main", "index": 0 }]] },
    "Consultar Status": { "main": [[{ "node": "Terminou?", "type": "main", "index": 0 }]] },
    "Terminou?": { "main": [[{ "node": "Baixar CSV Completo", "type": "main", "index": 0 }], [{ "node": "Aguardar 20s", "type": "main", "index": 0 }]] },
    "Baixar CSV Completo": { "main": [[{ "node": "Enviar CSV p/ Telegram", "type": "main", "index": 0 }]] }
  }
}
